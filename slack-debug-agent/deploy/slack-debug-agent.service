[Unit]
Description=Private Slack Silica diagnosis listener
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
User=ops
Group=ops
WorkingDirectory=/opt/silica-ops-agent
EnvironmentFile=/etc/slack-debug-agent/service.env
ExecStart=/opt/silica-ops-agent/.venv/bin/python /opt/silica-ops-agent/slack-debug-agent/main.py
Restart=on-failure
RestartSec=5
KillMode=control-group
TimeoutStopSec=20
UMask=0077

[Install]
WantedBy=multi-user.target
