# Copy to slack-debug-agent/deploy/service.env with mode 600 (ignored by Git).
# The systemd user service reads this file. Values do not expand $HOME or %h.
SLACK_BOT_TOKEN=xoxb-REPLACE
SLACK_USER_TOKEN=xoxp-REPLACE
SLACK_APP_TOKEN=xapp-REPLACE
# Required Slack member ID of the SLACK_USER_TOKEN owner, verified at startup.
# This token reads the escalation channel.
SLACK_USER_TOKEN_OWNER_ID=U_REPLACE
# Comma-separated Slack member IDs allowed to use the bot. Include the owner
# here if they should have access. An empty list grants access to nobody.
SLACK_DEBUG_ALLOWED_USERS=U_REPLACE
SLACK_DEBUG_CHANNEL_ID=C_REPLACE
SLACK_DEBUG_WORKSPACE_HOST=your-workspace.slack.com
# Compact DM activity: summary (default) or off. Commands are shown without output.
SLACK_DEBUG_ACTIVITY=summary
SLACK_DEBUG_CODEX_HOME=/home/ops/.local/share/slack-debug-codex
# For macOS local testing with --profile diagnose, use SLACK_DEBUG_CODEX_HOME=~/.codex.
# Include the installed Codex, git, gh, rtk, and diagnosis commands.
# macOS example: /opt/homebrew/bin:/Users/YOUR_USER/.local/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin
PATH=/home/ops/.local/bin:/usr/local/bin:/usr/bin:/bin
