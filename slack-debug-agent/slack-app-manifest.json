{
  "display_information": { "name": "Silica debug agent" },
  "features": {
    "app_home": { "home_tab_enabled": false, "messages_tab_enabled": true, "messages_tab_read_only_enabled": false },
    "bot_user": { "display_name": "Silica debug agent", "always_online": false },
    "slash_commands": [
      {
        "command": "/diagnose",
        "description": "Start an incident diagnosis from a channel or DM. Get the findings in a private DM.",
        "usage_hint": "<incident-permalink>"
      },
      {
        "command": "/report",
        "description": "Request an RCA draft from a channel or DM. Get the draft in the original diagnosis DM thread.",
        "usage_hint": "<slack-thread-permalink>"
      }
    ]
  },
  "oauth_config": {
    "scopes": {
      "bot": [
        "app_mentions:read",
        "channels:history",
        "groups:history",
        "channels:read",
        "groups:read",
        "chat:write",
        "files:write",
        "users:read",
        "im:history",
        "im:read",
        "im:write",
        "commands"
      ],
      "user": ["channels:history", "channels:read"]
    }
  },
  "settings": {
    "event_subscriptions": { "bot_events": ["message.im", "app_mention"] },
    "interactivity": { "is_enabled": true },
    "socket_mode_enabled": true,
    "org_deploy_enabled": false,
    "token_rotation_enabled": false
  }
}
