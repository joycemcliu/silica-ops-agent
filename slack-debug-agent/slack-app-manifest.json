{
  "display_information": {
    "name": "Silica debug agent",
    "background_color": "#1a1a2e"
  },
  "features": {
    "app_home": {
      "home_tab_enabled": false,
      "messages_tab_enabled": true,
      "messages_tab_read_only_enabled": false,
      "agent_tasks_enabled": true
    },
    "bot_user": {
      "display_name": "Silica debug agent",
      "always_online": false
    },
    "slash_commands": [
      {
        "command": "/diagnose",
        "description": "Start an incident diagnosis from a channel or DM. Get the findings in a private DM.",
        "usage_hint": "<incident-permalink>"
      },
      {
        "command": "/report",
        "description": "Request an RCA draft from a channel or DM. Get the draft in your diagnosis DM thread.",
        "usage_hint": "<slack-thread-permalink>"
      }
    ]
  },
  "oauth_config": {
    "scopes": {
      "user": ["groups:history", "channels:history", "channels:read"],
      "bot": [
        "app_mentions:read",
        "channels:history",
        "groups:history",
        "channels:read",
        "groups:read",
        "chat:write",
        "files:write",
        "users:read",
        "im:history",
        "im:read",
        "im:write",
        "commands"
      ]
    },
    "pkce_enabled": false
  },
  "settings": {
    "event_subscriptions": {
      "bot_events": ["message.im", "app_mention"]
    },
    "interactivity": {
      "is_enabled": true
    },
    "org_deploy_enabled": false,
    "socket_mode_enabled": true,
    "is_mcp_enabled": false,
    "token_rotation_enabled": false,
    "app_level_token_rotation_enabled": false
  }
}
