# Replace with your credentials path. Remove this assignment for local drafts.
# Relative paths resolve from the toolkit root.
RCA_GOOGLE_CREDENTIALS_FILE=credentials/rca-google-service-account.json

# Replace with your token file path when overriding the systemd default or starting HTTP manually.
# Remove this assignment to use the systemd default.
RCA_MCP_HTTP_TOKEN_FILE=/absolute/path/to/google-drive-rca-mcp-http-token
